<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtNomeDetalhes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nome do Filho"
            android:textColor="#212121"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtEmailDetalhes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="email@filho.com"
            android:textColor="#666666"
            android:textSize="16sp"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtNomeDetalhes" />

        <LinearLayout
            android:id="@+id/layoutAcoes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtEmailDetalhes">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerHistorico"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:text="Ver Histórico de Atividades"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_menu_recent_history" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerAlertasFilho"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:text="Ver Alertas"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_dialog_alert" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCriarRegra"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:text="Configurar Regras"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_menu_manage" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGerarRelatorio"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#009688"
                android:text="Compartilhar Relatório"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_menu_share" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltarDetalhes"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="Voltar ao Início"
            android:textAllCaps="false"
            android:textColor="#666666"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutAcoes" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
